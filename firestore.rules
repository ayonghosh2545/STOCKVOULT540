rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Hardened Global Helpers
    // ------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'ayonghosh549@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidAuthorizedUids(uids) {
      return uids is list && uids.size() >= 1 && uids.size() <= 20 && uids[0] is string && uids[0].size() <= 128;
    }

    function workspaceExists(wsId) {
      return exists(/databases/$(database)/documents/workspaces/$(wsId));
    }

    function getWorkspace(wsId) {
      return get(/databases/$(database)/documents/workspaces/$(wsId)).data;
    }

    function isWorkspaceOwner(wsId) {
      return isVerified() && workspaceExists(wsId) && getWorkspace(wsId).ownerId == request.auth.uid;
    }

    function memberDocExists(wsId, uid) {
      return exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(uid));
    }

    function getMember(wsId, uid) {
      return get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(uid)).data;
    }

    function isActiveMember(wsId) {
      return isVerified() && workspaceExists(wsId) && memberDocExists(wsId, request.auth.uid) && getMember(wsId, request.auth.uid).status == 'active';
    }

    function hasWorkspaceRole(wsId, roles) {
      return isAdmin() || isWorkspaceOwner(wsId) || (
        isActiveMember(wsId) && getMember(wsId, request.auth.uid).role in roles
      );
    }

    function canReadWorkspaceResource(wsId) {
      return hasWorkspaceRole(wsId, ['admin', 'manager', 'staff', 'viewer']);
    }

    function isWorkspaceAdmin(wsId) {
      return hasWorkspaceRole(wsId, ['admin']);
    }

    function isWorkspaceManagerOrAbove(wsId) {
      return hasWorkspaceRole(wsId, ['admin', 'manager']);
    }

    function isWorkspaceStaffOrAbove(wsId) {
      return hasWorkspaceRole(wsId, ['admin', 'manager', 'staff']);
    }

    // ------------------------------------------------------------------
    // Validation Blueprints
    // ------------------------------------------------------------------
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.createdAt == request.time;
    }

    function isValidWorkspace(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'warehouseName', 'currency',
          'lowStockThreshold', 'autoSync', 'autoBackup', 'encryptionEnabled',
          'pwaAppName', 'pwaShortName', 'authorizedUids', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'name', 'warehouseName', 'currency',
          'lowStockThreshold', 'autoSync', 'autoBackup', 'encryptionEnabled',
          'pwaAppName', 'pwaShortName', 'authorizedUids', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.warehouseName is string && data.warehouseName.size() >= 1 && data.warehouseName.size() <= 120 &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 8 &&
        data.lowStockThreshold is number && data.lowStockThreshold >= 0 && data.lowStockThreshold <= 100000 &&
        data.autoSync is bool &&
        data.autoBackup is bool &&
        data.encryptionEnabled is bool &&
        data.pwaAppName is string && data.pwaAppName.size() >= 1 && data.pwaAppName.size() <= 60 &&
        data.pwaShortName is string && data.pwaShortName.size() >= 1 && data.pwaShortName.size() <= 12 &&
        isValidAuthorizedUids(data.authorizedUids) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidWorkspaceMember(data) {
      return data.keys().hasAll(['uid', 'ownerId', 'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'ownerId', 'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        isValidId(data.ownerId) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.role in ['admin', 'manager', 'staff', 'viewer'] &&
        data.status in ['active', 'suspended'] &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidStaffAccessProfile(data) {
      return data.keys().hasAll(['id', 'ownerId', 'authorizedUids', 'label', 'role', 'codeHash', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'authorizedUids', 'label', 'role', 'codeHash', 'active', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidAuthorizedUids(data.authorizedUids) &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
        data.role in ['admin', 'manager', 'staff', 'viewer'] &&
        data.codeHash is string && data.codeHash.size() >= 16 && data.codeHash.size() <= 128 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidStockProduct(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'authorizedUids', 'sku', 'name', 'category',
          'boxNumber', 'rackLocation', 'quantity', 'minStock', 'unitPrice',
          'unit', 'supplier', 'qrCodeValue', 'notes', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'authorizedUids', 'sku', 'name', 'category',
          'boxNumber', 'rackLocation', 'quantity', 'minStock', 'unitPrice',
          'unit', 'supplier', 'qrCodeValue', 'notes', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidAuthorizedUids(data.authorizedUids) &&
        data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.boxNumber is string && data.boxNumber.size() >= 1 && data.boxNumber.size() <= 40 &&
        data.rackLocation is string && data.rackLocation.size() <= 80 &&
        data.quantity is number && data.quantity >= 0 && data.quantity <= 100000000 &&
        data.minStock is number && data.minStock >= 0 && data.minStock <= 1000000 &&
        data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 100000000 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 24 &&
        data.supplier is string && data.supplier.size() <= 120 &&
        data.qrCodeValue is string && data.qrCodeValue.size() >= 1 && data.qrCodeValue.size() <= 200 &&
        data.notes is string && data.notes.size() <= 500 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidMonthlyPayment(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'authorizedUids', 'title', 'payee', 'category',
          'month', 'amount', 'paidAmount', 'dueDate', 'status', 'method',
          'notes', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'authorizedUids', 'title', 'payee', 'category',
          'month', 'amount', 'paidAmount', 'dueDate', 'status', 'method',
          'notes', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidAuthorizedUids(data.authorizedUids) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.payee is string && data.payee.size() >= 1 && data.payee.size() <= 120 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.month is string && data.month.size() == 7 && data.month.matches('^[0-9]{4}-[0-9]{2}$') &&
        data.amount is number && data.amount >= 0 && data.amount <= 1000000000 &&
        data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= 1000000000 &&
        data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.status in ['paid', 'pending', 'overdue'] &&
        data.method is string && data.method.size() <= 40 &&
        data.notes is string && data.notes.size() <= 400 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidAppNotification(data) {
      return data.keys().hasAll(['id', 'ownerId', 'authorizedUids', 'title', 'message', 'type', 'read', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'authorizedUids', 'title', 'message', 'type', 'read', 'createdBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidAuthorizedUids(data.authorizedUids) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 400 &&
        data.type in ['low_stock', 'payment_due', 'sync', 'security', 'backup'] &&
        data.read is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidCloudBackup(data) {
      return data.keys().hasAll(['id', 'ownerId', 'authorizedUids', 'label', 'itemCount', 'encrypted', 'checksum', 'payload', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'authorizedUids', 'label', 'itemCount', 'encrypted', 'checksum', 'payload', 'createdBy', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidAuthorizedUids(data.authorizedUids) &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
        data.itemCount is number && data.itemCount >= 0 && data.itemCount <= 1000000 &&
        data.encrypted is bool &&
        data.checksum is string && data.checksum.size() >= 8 && data.checksum.size() <= 128 &&
        data.payload is string && data.payload.size() >= 2 && data.payload.size() <= 850000 &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt == request.time;
    }

    // ------------------------------------------------------------------
    // Collection Match Blocks
    // ------------------------------------------------------------------

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isVerified() && request.auth.uid == adminId));
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isBootstrappedAdmin() && isValidAdminUser(incoming()) && incoming().uid == adminId;
      allow update, delete: if isValidId(adminId) && isBootstrappedAdmin();
    }

    match /workspaces/{workspaceId} {
      allow get: if isValidId(workspaceId) && canReadWorkspaceResource(workspaceId);
      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.authorizedUids
      );
      allow create: if isValidId(workspaceId) &&
        isVerified() &&
        isValidWorkspace(incoming()) &&
        incoming().id == workspaceId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        request.auth.uid in incoming().authorizedUids;
      allow update: if isValidId(workspaceId) &&
        isVerified() &&
        isValidWorkspace(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        isWorkspaceAdmin(workspaceId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'warehouseName', 'currency', 'lowStockThreshold',
          'autoSync', 'autoBackup', 'encryptionEnabled',
          'pwaAppName', 'pwaShortName', 'authorizedUids', 'updatedAt'
        ]);
      allow delete: if isValidId(workspaceId) && (isAdmin() || isWorkspaceOwner(workspaceId));

      match /members/{memberUid} {
        allow get: if isValidId(workspaceId) && isValidId(memberUid) && (
          isAdmin() ||
          isWorkspaceOwner(workspaceId) ||
          isWorkspaceAdmin(workspaceId) ||
          (isVerified() && request.auth.uid == memberUid)
        );
        allow list: if isVerified() && (
          isBootstrappedAdmin() ||
          resource.data.ownerId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        );
        allow create: if isValidId(workspaceId) && isValidId(memberUid) &&
          isVerified() &&
          isValidWorkspaceMember(incoming()) &&
          incoming().uid == memberUid &&
          incoming().ownerId == getWorkspace(workspaceId).ownerId &&
          incoming().createdAt == request.time &&
          isWorkspaceAdmin(workspaceId);
        allow update: if isValidId(workspaceId) && isValidId(memberUid) &&
          isVerified() &&
          isValidWorkspaceMember(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          isWorkspaceAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'role', 'status', 'updatedAt']);
        allow delete: if isValidId(workspaceId) && isValidId(memberUid) && isWorkspaceAdmin(workspaceId);
      }

      match /staffProfiles/{profileId} {
        allow get: if isValidId(workspaceId) && isValidId(profileId) && isWorkspaceAdmin(workspaceId);
        allow list: if isVerified() && (
          isBootstrappedAdmin() ||
          resource.data.ownerId == request.auth.uid
        );
        allow create: if isValidId(workspaceId) && isValidId(profileId) &&
          isVerified() &&
          isValidStaffAccessProfile(incoming()) &&
          incoming().id == profileId &&
          incoming().ownerId == getWorkspace(workspaceId).ownerId &&
          incoming().createdAt == request.time &&
          isWorkspaceAdmin(workspaceId);
        allow update: if isValidId(workspaceId) && isValidId(profileId) &&
          isVerified() &&
          isValidStaffAccessProfile(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          isWorkspaceAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['authorizedUids', 'label', 'role', 'codeHash', 'active', 'updatedAt']);
        allow delete: if isValidId(workspaceId) && isValidId(profileId) && isWorkspaceAdmin(workspaceId);
      }

      match /products/{productId} {
        allow get: if isValidId(workspaceId) && isValidId(productId) && canReadWorkspaceResource(workspaceId);
        allow list: if isVerified() && (
          isBootstrappedAdmin() ||
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.authorizedUids
        );
        allow create: if isValidId(workspaceId) && isValidId(productId) &&
          isVerified() &&
          isValidStockProduct(incoming()) &&
          incoming().id == productId &&
          incoming().ownerId == getWorkspace(workspaceId).ownerId &&
          incoming().createdAt == request.time &&
          isWorkspaceManagerOrAbove(workspaceId);
        allow update: if isValidId(workspaceId) && isValidId(productId) &&
          isVerified() &&
          isValidStockProduct(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && (
            (isWorkspaceManagerOrAbove(workspaceId) && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorizedUids', 'sku', 'name', 'category', 'boxNumber', 'rackLocation',
              'quantity', 'minStock', 'unitPrice', 'unit', 'supplier', 'qrCodeValue',
              'notes', 'updatedBy', 'updatedAt'
            ])) ||
            (isWorkspaceStaffOrAbove(workspaceId) && incoming().diff(existing()).affectedKeys().hasOnly([
              'quantity', 'boxNumber', 'rackLocation', 'notes', 'updatedBy', 'updatedAt'
            ]))
          );
        allow delete: if isValidId(workspaceId) && isValidId(productId) && isWorkspaceManagerOrAbove(workspaceId);
      }

      match /payments/{paymentId} {
        allow get: if isValidId(workspaceId) && isValidId(paymentId) && canReadWorkspaceResource(workspaceId);
        allow list: if isVerified() && (
          isBootstrappedAdmin() ||
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.authorizedUids
        );
        allow create: if isValidId(workspaceId) && isValidId(paymentId) &&
          isVerified() &&
          isValidMonthlyPayment(incoming()) &&
          incoming().id == paymentId &&
          incoming().ownerId == getWorkspace(workspaceId).ownerId &&
          incoming().createdAt == request.time &&
          isWorkspaceManagerOrAbove(workspaceId);
        allow update: if isValidId(workspaceId) && isValidId(paymentId) &&
          isVerified() &&
          isValidMonthlyPayment(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && (
            (isWorkspaceAdmin(workspaceId) && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorizedUids', 'title', 'payee', 'category', 'month', 'amount',
              'paidAmount', 'dueDate', 'status', 'method', 'notes', 'updatedBy', 'updatedAt'
            ])) ||
            (isWorkspaceManagerOrAbove(workspaceId) && existing().status != 'paid' && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'payee', 'category', 'month', 'amount',
              'paidAmount', 'dueDate', 'status', 'method', 'notes', 'updatedBy', 'updatedAt'
            ]))
          );
        allow delete: if isValidId(workspaceId) && isValidId(paymentId) && isWorkspaceAdmin(workspaceId);
      }

      match /notifications/{notificationId} {
        allow get: if isValidId(workspaceId) && isValidId(notificationId) && canReadWorkspaceResource(workspaceId);
        allow list: if isVerified() && (
          isBootstrappedAdmin() ||
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.authorizedUids
        );
        allow create: if isValidId(workspaceId) && isValidId(notificationId) &&
          isVerified() &&
          isValidAppNotification(incoming()) &&
          incoming().id == notificationId &&
          incoming().ownerId == getWorkspace(workspaceId).ownerId &&
          incoming().createdAt == request.time &&
          isWorkspaceStaffOrAbove(workspaceId);
        allow update: if isValidId(workspaceId) && isValidId(notificationId) &&
          isVerified() &&
          isValidAppNotification(incoming()) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && (
            isWorkspaceAdmin(workspaceId) ||
            (canReadWorkspaceResource(workspaceId) && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']))
          );
        allow delete: if isValidId(workspaceId) && isValidId(notificationId) && isWorkspaceAdmin(workspaceId);
      }

      match /backups/{backupId} {
        allow get: if isValidId(workspaceId) && isValidId(backupId) && isWorkspaceManagerOrAbove(workspaceId);
        allow list: if isVerified() && (
          isBootstrappedAdmin() ||
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.authorizedUids
        );
        allow create: if isValidId(workspaceId) && isValidId(backupId) &&
          isVerified() &&
          isValidCloudBackup(incoming()) &&
          incoming().id == backupId &&
          incoming().ownerId == getWorkspace(workspaceId).ownerId &&
          incoming().createdAt == request.time &&
          isWorkspaceManagerOrAbove(workspaceId);
        allow update: if false;
        allow delete: if isValidId(workspaceId) && isValidId(backupId) && isWorkspaceAdmin(workspaceId);
      }
    }
  }
}
